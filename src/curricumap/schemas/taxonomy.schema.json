{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["taxonomy"],
  "properties": {
    "taxonomy": {
      "type": "object",
      "required": ["id", "label", "domains", "rules"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "locale": {"type": "object", "properties": {
          "language": {"type": "string"}, "casefold": {"type": "string"}}},
        "domains": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["id", "label"],
          "properties": {"id": {"type": "string"}, "label": {"type": "string"}}}},
        "match": {"type": "object", "properties": {
          "strategy": {"type": "string", "enum": ["ordered_rules"]},
          "fuzzy": {"type": "object", "properties": {
            "enabled": {"type": "boolean"},
            "threshold": {"type": "number", "minimum": 0, "maximum": 1},
            "scorer": {"type": "string"}}}}},
        "rules": {"type": "array", "items": {
          "type": "object", "required": ["domain", "any"],
          "properties": {"domain": {"type": "string"},
                         "any": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
        "overrides": {"type": "array", "items": {
          "type": "object", "required": ["course", "domain"],
          "properties": {"course": {"type": "string"}, "domain": {"type": "string"}}}},
        "defaults": {"type": "object", "properties": {"unmatched": {"type": "string"}}}
      }
    }
  }
}
